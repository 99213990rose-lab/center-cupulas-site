{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site-ri-cos.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site-git-main-ri-cos.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site-ri-cos.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "center-cupulas-site-git-main-ri-cos.vercel.app"
        }
      ],
      "destination": "https://www.centercupulas.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/catalogo",
      "destination": "/catalogo.pdf"
    }
  ],
  "headers": [
    {
      "source": "/catalogo.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Catalogo-Center-Cupulas.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/catalogo",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Catalogo-Center-Cupulas.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
